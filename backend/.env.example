# DecentralChat Environment Configuration Example
# Copy to .env and fill in your values. Never commit .env with real credentials.

# Server Configuration
PORT=8080
DEBUG=false
ALLOWED_ORIGIN=http://localhost:8080
TRUST_PROXY=false

# Security & Tokens
SECRET_KEY=generate-a-strong-random-32byte-secret-here
# FERNET_KEY=optional-base64-32byte-fernet-key-or-auto-generated

# Admin user IDs (comma-separated user UUIDs)
ADMIN_USER_IDS=

# Redis Configuration (Leave as-is for local development fallback)
REDIS_URL=redis://localhost:6379

# Google OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio Phone Verification (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase / Firestore Service Account Path (Optional)
FIREBASE_CRED_PATH=firebase-config.json
