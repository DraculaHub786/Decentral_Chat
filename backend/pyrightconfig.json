{
  "include": [
    ".",
    "app"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "uploads"
  ],
  "venvPath": "..",
  "venv": ".venv",
  "extraPaths": [
    "../.venv/Lib/site-packages",
    ".",
    "app"
  ],
  "pythonVersion": "3.11",
  "pythonPlatform": "Windows",
  "typeCheckingMode": "basic",
  "reportMissingImports": "none",
  "diagnosticSeverityOverrides": {
    "reportMissingImports": "none",
    "reportMissingModuleSource": "none"
  }
}
